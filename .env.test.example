# Copy to .env.test (gitignored) and fill in real sandbox values when needed.
# Unit tests run fully against mocked HTTP and work with these placeholders.
WAVEBIRD_SECRET_KEY=sk_test_YOUR_SANDBOX_KEY
WAVEBIRD_CLIENT_ID=wbproj_YOUR_PROJECT_ID

# Browser (publishable) key — only needed to exercise #activate_browser, the
# secondary Script Tag / pure-browser path. Safe for frontend delivery by design;
# the key's allowed origins are what protect it.
WAVEBIRD_PUBLISHABLE_KEY=pk_test_YOUR_BROWSER_KEY

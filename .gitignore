# Anchored: a bare `upstream/` matches ANY directory of that name, which
# silently excluded docs/upstream/ -- the dated API and render.js snapshots
# that render_js_contract_spec reads. A fresh clone had none of them and
# failed 12 examples; CI would have failed on the first push.
/upstream/

# local env files
.env*
!.env.test.example

# bundler / build artifacts
/.bundle/
/Gemfile.lock
/gemfiles/*.lock
/pkg/
# `gem build` writes the artifact to the repo root, not pkg/, so ignore it there
# too — it is a build output and it is large.
/*.gem
/coverage/
/doc/
/.yardoc/
/tmp/
